---
import "@/styles/globals.css";
import Masthead from "@/components/Masthead.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  compact?: boolean;
}

const {
  title,
  description = "The Merchback Machine — a digital museum of startup merch. Browse tees, caps, stickers, keycaps and oddities by year and by company.",
  compact = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f3eee1'/%3E%3Crect x='4' y='7' width='24' height='3' fill='%231b1a17'/%3E%3Crect x='4' y='14' width='16' height='3' fill='%23b03a20'/%3E%3Crect x='4' y='21' width='20' height='3' fill='%231d6f6f'/%3E%3C/svg%3E"
    />
  </head>
  <body class="min-h-screen antialiased">
    <Masthead compact={compact} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
