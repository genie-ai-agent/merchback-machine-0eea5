---
import SpecimenPlate from "@/components/SpecimenPlate.tsx";
import { accession, typeLabel } from "@/data/collection";
import { photoFor } from "@/data/photos";
import type { Artifact } from "@/data/types";

interface Props {
  artifact: Artifact;
}
const { artifact } = Astro.props;
const photo = photoFor(artifact.id);
---

<a href={`/artifact/${artifact.id}`} class="plate frame group relative block">
  {
    artifact.rarity === "grail" && (
      <span class="stamp absolute top-2 right-2 z-10 bg-[var(--color-card)]">grail</span>
    )
  }
  <div class="scanlines relative border-b border-ink">
    {
      photo ? (
        <img
          src={photo.src}
          alt={photo.alt ?? `${artifact.name}, ${artifact.company}, ${artifact.year}`}
          loading="lazy"
          decoding="async"
          class="block aspect-square w-full bg-[#f1ebdc] object-contain"
        />
      ) : (
        <SpecimenPlate artifact={artifact} />
      )
    }
    <span class="acc absolute bottom-1 left-1 bg-[var(--color-card)] px-1 py-0.5 text-[0.5rem] text-[var(--color-ink-3)]">
      {photo ? "photo" : "drawing"}
    </span>
  </div>
  <div class="p-3">
    <p class="acc text-[var(--color-capture)]">{accession(artifact)}</p>
    <h3
      class="mt-1 font-display text-[0.85rem] leading-snug font-bold sm:text-[0.95rem] group-hover:text-[var(--color-stamp)]"
    >
      {artifact.name}
    </h3>
    <p class="meta mt-1.5">
      {artifact.company} · {artifact.year}{artifact.dating === "estimated" ? " ≈" : ""}
    </p>
    <p class="meta mt-0.5 text-[var(--color-ink-2)]">{typeLabel(artifact.type)}</p>
  </div>
</a>
