---
import { ALL, CATALOGUE_UPDATED, FIRST_YEAR, LAST_YEAR } from "@/data/collection";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/", label: "Front Desk" },
  { href: "/browse", label: "Browse Holdings" },
  { href: "/#timeline", label: "Timeline" },
  { href: "/#companies", label: "Companies" },
  { href: "/about", label: "About / Donate" },
];
---

<header class="border-b border-ink bg-[var(--color-paper-2)]">
  <!-- utility strip -->
  <div class="border-b border-rule bg-ink text-[var(--color-paper)]">
    <div
      class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-1.5 font-mono text-[0.6rem] tracking-[0.16em] uppercase"
    >
      <span>Merchback Machine · Digital Merch Archive</span>
      <span class="hidden sm:inline opacity-70"
        >{ALL.length} holdings · {FIRST_YEAR}–{LAST_YEAR} · rev. {CATALOGUE_UPDATED}</span
      >
      <span class="sm:hidden opacity-70">{ALL.length} holdings</span>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4">
    <div class={`flex flex-col gap-3 ${compact ? "py-4" : "py-6"} sm:flex-row sm:items-end sm:justify-between`}>
      <a href="/" class="group block">
        <div class="flex items-end gap-3">
          <!-- stacked-bars logo, wayback capture-graph flavored -->
          <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0" aria-hidden="true">
            <rect width="40" height="40" fill="#1b1a17"></rect>
            <rect x="6" y="8" width="28" height="4" fill="#f3eee1"></rect>
            <rect x="6" y="16" width="18" height="4" fill="#b03a20"></rect>
            <rect x="6" y="24" width="24" height="4" fill="#1d6f6f"></rect>
            <rect x="6" y="32" width="12" height="3" fill="#e8c547"></rect>
          </svg>
          <div>
            <h1
              class={`font-display font-bold leading-none tracking-tight ${compact ? "text-2xl sm:text-3xl" : "text-3xl sm:text-5xl"}`}
            >
              Merchback<span class="text-[var(--color-stamp)]"> Machine</span>
            </h1>
            <p class="meta mt-1.5">A digital museum of startup merch</p>
          </div>
        </div>
      </a>

      <form action="/browse" method="get" class="flex w-full max-w-sm items-stretch sm:w-auto">
        <label for="mast-q" class="sr-only">Search the collection</label>
        <input
          id="mast-q"
          type="search"
          name="q"
          placeholder={`Search ${ALL.length} objects…`}
          class="min-w-0 flex-1 border border-ink border-r-0 bg-[var(--color-card)] px-3 py-2.5 font-mono text-xs placeholder:text-[var(--color-ink-3)] focus:outline-none focus:ring-2 focus:ring-[var(--color-capture)] focus:ring-offset-0"
        />
        <button
          type="submit"
          class="border border-ink bg-ink px-4 py-2.5 font-mono text-[0.65rem] tracking-[0.14em] uppercase text-[var(--color-paper)] transition-colors hover:bg-[var(--color-stamp)]"
        >
          Retrieve
        </button>
      </form>
    </div>

    <nav class="no-scrollbar -mx-4 overflow-x-auto border-t border-rule px-4">
      <ul class="flex min-w-max items-center gap-5 py-2">
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                class={`font-mono text-[0.65rem] tracking-[0.14em] uppercase transition-colors hover:text-[var(--color-stamp)] ${
                  path === n.href ? "text-[var(--color-stamp)] underline decoration-2 underline-offset-4" : "text-[var(--color-ink-2)]"
                }`}
              >
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
